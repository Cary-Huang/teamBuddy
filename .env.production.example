# Copy this file to a protected path on the production self-hosted runner.
# Never commit the real file.
DATABASE_URL=postgres://USER:PASSWORD@DB_HOST:5432/teambuddy
WEB_ORIGIN=https://teambuddy.example.com
TEAM_ID=00000000-0000-0000-0000-000000000000
API_PORT=3001
WEB_PORT=3000
WORKER_ID=teambuddy-production-worker

# Used only when running compose.production.yml manually. GitHub Actions overrides both.
IMAGE_OWNER=your-github-owner
IMAGE_TAG=main
